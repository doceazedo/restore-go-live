{
  "compilerOptions": {
    "resolveJsonModule": true,
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "allowJs": true,
    "lib": ["DOM", "DOM.Iterable", "esnext"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitAny": false,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "target": "ESNEXT",
    "jsx": "preserve",
    "noEmit": true,
    "paths": {
      "@runtime/*": ["./runtime/*"]
    },
    "types": ["node"]
  },
  "include": ["src/**/*", "runtime/**/*"]
}
